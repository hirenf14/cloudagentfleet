# ── Hub (Controller) ──────────────────────────────────────────────
CLOUDAGENTFLEET_HOST=127.0.0.1
CLOUDAGENTFLEET_PORT=8787
# Hub state file (instances, sessions, audit).
# CLOUDAGENTFLEET_DATA_PATH=data/hub.json
# Bearer token Workers and the CLI use; required when binding beyond loopback.
# CLOUDAGENTFLEET_AUTH_TOKEN=
# Optional. If unset, Hub generates a password on first run, stores it under
# data/hub-ui-auth.json, and prints it on every start until you set one of these:
# CLOUDAGENTFLEET_UI_PASSWORD=
# CLOUDAGENTFLEET_UI_PASSWORD_HASH=
# CLOUDAGENTFLEET_UI_SESSION_TTL_MS=
# Force Secure cookies when TLS terminates in front of the Hub.
# CLOUDAGENTFLEET_COOKIE_SECURE=true
# Per-instance Codeman Basic credentials, kept server-side:
# CLOUDAGENTFLEET_CODEMAN_CREDENTIALS={"codeman-remote":{"username":"u","password":"p"}}

# ── Worker (normally written by `cloudagentfleet setup`) ──────────
# CLOUDAGENTFLEET_CONTROLLER_URL=http://127.0.0.1:8787
# CLOUDAGENTFLEET_NODE_ID=
# CLOUDAGENTFLEET_NODE_NAME=
# CLOUDAGENTFLEET_WORKSPACE_MODE=folders
# CLOUDAGENTFLEET_WORKSPACE_ROOTS=/home/me/src;/home/me/work
# CLOUDAGENTFLEET_WORKSPACES=[]
# CLOUDAGENTFLEET_CODEMAN_URL=http://127.0.0.1:3000
# CLOUDAGENTFLEET_CODEMAN_INSTANCE_ID=
# CLOUDAGENTFLEET_CODEMAN_MODE=claude
# CLOUDAGENTFLEET_CODEMAN_USERNAME=
# CLOUDAGENTFLEET_CODEMAN_PASSWORD=
# Set to false to run against an existing Codeman without supervision.
# CLOUDAGENTFLEET_MANAGE_CODEMAN=true
# CLOUDAGENTFLEET_CODEMAN_INSTALL=true
# WSL distribution used on Windows.
# CLOUDAGENTFLEET_WSL_DISTRO=Ubuntu
