{
  "name": "cloudagentfleet",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Agent Fleet monorepo — Hub, UI, and Worker packages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hirenf14/cloudagentfleet.git"
  },
  "homepage": "https://github.com/hirenf14/cloudagentfleet#readme",
  "bugs": {
    "url": "https://github.com/hirenf14/cloudagentfleet/issues"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "build:release": "node scripts/build-release.mjs",
    "package:standalone": "node scripts/package-standalone.mjs",
    "verify:packs": "node scripts/verify-npm-packs.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:release && changeset publish",
    "dev": "pnpm --parallel --filter @cloudagentfleet/hub --filter @cloudagentfleet/worker dev",
    "test": "pnpm -r test",
    "test:multihost:mock": "pnpm --filter @cloudagentfleet/hub test:multihost:mock",
    "test:multihost:live": "pnpm --filter @cloudagentfleet/hub test:multihost:live",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.5",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
