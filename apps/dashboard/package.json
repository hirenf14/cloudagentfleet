{
  "name": "@cloudagentfleet/ui",
  "version": "0.1.1",
  "private": false,
  "description": "Cloud Agent Fleet Hub UI assets.",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./public/*": "./dist/public/*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../scripts/build-release.mjs",
    "dev": "node --watch --check public/app.js",
    "test": "node --test",
    "typecheck": "node --check public/app.js",
    "prepublishOnly": "node ../../scripts/build-release.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
