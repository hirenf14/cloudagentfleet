{
  "name": "@cloudagentfleet/worker",
  "version": "0.1.0",
  "private": false,
  "description": "Cloud Agent Fleet Worker — machine companion and operator CLI.",
  "type": "module",
  "bin": {
    "cloudagentfleet": "./bin/cloudagentfleet.mjs",
    "cloudagentfleet-worker": "./bin/cloudagentfleet-worker.mjs",
    "hosted-agents": "./bin/cloudagentfleet.mjs"
  },
  "files": [
    "bin",
    "dist",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --noEmit",
