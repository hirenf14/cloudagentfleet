{
  "name": "@cloudagentfleet/hub",
  "version": "0.4.2",
  "private": false,
  "license": "MIT",
  "description": "Cloud Agent Fleet Hub: the private dashboard (included) and fleet API, with the cloudagentfleet CLI; can also run a Worker on the same machine.",
  "type": "module",
  "bin": {
    "cloudagentfleet-hub": "./dist/cloudagentfleet-hub.mjs",
    "cloudagentfleet": "./dist/cloudagentfleet.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techoblix/cloudagentfleet.git",
    "directory": "apps/control-plane"
  },
  "homepage": "https://github.com/techoblix/cloudagentfleet/tree/master/apps/control-plane#readme",
  "bugs": {
    "url": "https://github.com/techoblix/cloudagentfleet/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test",
    "test:multihost:mock": "node --experimental-strip-types src/multihost-harness.ts --mock",
    "test:multihost:live": "node --experimental-strip-types src/multihost-harness.ts --live",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
